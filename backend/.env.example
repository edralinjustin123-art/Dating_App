NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:replace-with-your-local-password@localhost:5432/datemate
DATABASE_SSL=false
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=datemate-api
JWT_AUDIENCE=datemate-app
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_URL=datemate://reset-password
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
TRUST_PROXY=0

# SMTP is required for password-reset email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DateMate <no-reply@example.com>

# S3-compatible object storage is required for profile photo uploads.
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=3600

# OAuth is optional until provider credentials and callback allowlists are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
OAUTH_REDIRECT_URIS=datematee://auth/callback

# Socket.IO is served by the same host and port as the REST API.
