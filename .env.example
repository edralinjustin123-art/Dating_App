# Copy this file to .env.local and fill in the two PUBLIC project settings.
# Supabase dashboard: Project Settings > Data API / API Keys.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Use an sb_publishable_... key. Never place an sb_secret_... key, service-role
# key, Google client secret, or Apple signing key in EXPO_PUBLIC_ variables.
